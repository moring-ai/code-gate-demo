# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=
# Needed for real Claude models. Leave empty to rehearse with the demo-mock model only.
ANTHROPIC_API_KEY=
# Gateway -> evidence API (write) and CI -> evidence API (read). Must differ.
EVIDENCE_INGEST_TOKEN=
EVIDENCE_QUERY_TOKEN=
# Optional: HMAC key for line hashes. If set, also add it to GitHub secrets as FP_HMAC_KEY.
FP_HMAC_KEY=
# Optional override of org_policy.yml mode: monitor | enforce
ORG_POLICY_MODE=
